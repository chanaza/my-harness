{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chanaza/my-harness/schemas/compaction.schema.json",
  "title": "Compaction summary frontmatter (sessions/<tool>/<id>/compactions/NNN.md)",
  "type": "object",
  "required": [
    "session",
    "index",
    "at",
    "source"
  ],
  "properties": {
    "session": {
      "type": "string"
    },
    "index": {
      "type": "integer",
      "minimum": 1
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": [
        "tool-compaction",
        "checkpoint"
      ]
    },
    "context_percent": {
      "type": "number"
    }
  },
  "additionalProperties": false
}
