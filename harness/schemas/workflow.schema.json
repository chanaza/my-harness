{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chanaza/my-harness/schemas/workflow.schema.json",
  "title": "Workflow definition (core/workflows/<name>.yaml or apps/<app>/workflows/)",
  "type": "object",
  "required": [
    "name",
    "description",
    "steps",
    "provenance"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "description": {
      "type": "string"
    },
    "trigger": {
      "type": "string",
      "description": "What starts the workflow, in plain words."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "agent": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "skill": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "additionalProperties": true
      }
    },
    "requires": {
      "type": "object",
      "description": "What must exist in a tool for this to work. Names only, never secrets.",
      "properties": {
        "connections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true,
          "description": "Ids from core/connections.yaml."
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Built-in capabilities, e.g. web-search, code-execution."
        }
      },
      "additionalProperties": false
    },
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "description": "Language this file is written in."
    },
    "original": {
      "type": "string",
      "description": "Relative path to the original-language version, when this file is a translation."
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    },
    "origin": {
      "type": "string"
    },
    "native": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      },
      "description": "The tool's own record of the task, keyed by profile."
    }
  },
  "additionalProperties": false
}
