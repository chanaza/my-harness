{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chanaza/my-harness/schemas/plugin.schema.json",
  "title": "Plugin descriptor (core/plugins/<name>/plugin.yaml)",
  "type": "object",
  "required": [
    "name",
    "description",
    "provenance"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[^\\W_A-Z](?:[^\\W_A-Z]|-)*$"
    },
    "description": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    },
    "agent": {
      "type": "string",
      "description": "The agent this belongs to (core/agents/<agent>.yaml)."
    }
  },
  "additionalProperties": false
}
