{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chanaza/my-harness/schemas/session_meta.schema.json",
  "title": "Session metadata (sessions/<tool>/<session-id>/meta.yaml)",
  "type": "object",
  "required": [
    "id",
    "profile",
    "started_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Profile id from core/profiles.yaml (a tool + account)."
    },
    "topic": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "native_id": {
      "type": "string",
      "description": "The tool's own conversation id, when it has one."
    },
    "used": {
      "type": "object",
      "description": "What must exist in a tool for this to work. Names only, never secrets.",
      "properties": {
        "connections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true,
          "description": "Ids from core/connections.yaml."
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Built-in capabilities, e.g. web-search, code-execution."
        }
      },
      "additionalProperties": false
    },
    "transcript": {
      "type": "string",
      "description": "Key of the transcript in transcript storage."
    },
    "project": {
      "type": "string",
      "description": "Working folder or project the session ran in."
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "workspace": {
      "type": "array",
      "description": "Git repositories the session worked in.",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "remote": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "head": {
            "type": "string"
          },
          "dirty": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set when the session was imported after the fact (no checkpoints were written live)."
    }
  },
  "additionalProperties": false
}
