{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chanaza/my-harness/schemas/connections.schema.json",
  "title": "Connection registry (core/connections.yaml)",
  "type": "object",
  "required": [
    "connections"
  ],
  "properties": {
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[^\\W_A-Z](?:[^\\W_A-Z]|-)*$"
          },
          "description": {
            "type": "string"
          },
          "available_in": {
            "type": "object",
            "description": "Per tool: how to get this connection there (mcp, plugin, native, api).",
            "additionalProperties": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "mcp",
                    "plugin",
                    "native",
                    "api",
                    "manual",
                    "connector"
                  ]
                },
                "notes": {
                  "type": "string"
                },
                "profiles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Profiles that have this connection in that tool."
                }
              }
            }
          },
          "provenance": {
            "$ref": "provenance.schema.json"
          },
          "kind": {
            "enum": [
              "mcp",
              "plugin",
              "api",
              "native",
              "connector"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
