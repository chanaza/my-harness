{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chanaza/my-harness/schemas/harness-describe.schema.json",
  "title": "harness-describe/1",
  "description": "Everything a tool account has built, one list per kind of the harness (written by a tool's harness skill through the harness connector).",
  "type": "object",
  "required": [
    "schema",
    "profile",
    "tool",
    "captured_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "named": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "text": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          }
        }
      },
      "description": "The item's files, in full (path inside the item -> text)."
    }
  },
  "properties": {
    "schema": {
      "const": "harness-describe/1"
    },
    "captured_at": {
      "type": [
        "string",
        "object"
      ]
    },
    "surface": {
      "type": "string",
      "description": "Where inside the tool, e.g. cowork, claude-ai, desktop."
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "The harness profile this tool account is (written into the skill)."
    },
    "instructions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/named"
          },
          {
            "$ref": "#/$defs/text"
          }
        ]
      }
    },
    "memory": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/text"
          },
          {
            "properties": {
              "name": {
                "type": "string",
                "description": "The topic, e.g. the memory file's name."
              }
            }
          }
        ]
      }
    },
    "skills": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/named"
          },
          {
            "properties": {
              "origin": {
                "enum": [
                  "mine",
                  "anthropic",
                  "plugin",
                  "marketplace"
                ],
                "description": "mine = the user built it; anything else is kept by name only."
              },
              "files": {
                "$ref": "#/$defs/files"
              },
              "not_readable": {
                "type": "string"
              }
            }
          },
          {
            "if": {
              "properties": {
                "origin": {
                  "const": "mine"
                }
              },
              "required": [
                "origin"
              ]
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "files"
                  ]
                },
                {
                  "required": [
                    "not_readable"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "agents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/named"
          },
          {
            "properties": {
              "files": {
                "$ref": "#/$defs/files"
              }
            }
          }
        ]
      }
    },
    "plugins": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/named"
          },
          {
            "properties": {
              "origin": {
                "enum": [
                  "mine",
                  "anthropic",
                  "plugin",
                  "marketplace"
                ],
                "description": "mine = the user built it; anything else is kept by name only."
              },
              "files": {
                "$ref": "#/$defs/files"
              },
              "not_readable": {
                "type": "string"
              }
            }
          },
          {
            "if": {
              "properties": {
                "origin": {
                  "const": "mine"
                }
              },
              "required": [
                "origin"
              ]
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "files"
                  ]
                },
                {
                  "required": [
                    "not_readable"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "connections": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/named"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "connector",
                  "mcp"
                ]
              }
            }
          }
        ]
      }
    },
    "projects": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/named"
          },
          {
            "properties": {
              "instructions": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "knowledge": {
                "$ref": "#/$defs/files"
              },
              "not_readable": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "workflows": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/named"
      }
    },
    "apps": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/named"
          },
          {
            "properties": {
              "files": {
                "$ref": "#/$defs/files"
              },
              "link": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "not_readable": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "native": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/named"
      }
    },
    "cannot_see": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "tool": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "The tool that wrote it, e.g. claude-ai, cowork, chatgpt."
    },
    "user_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "null"
        }
      ],
      "description": "What the tool knows about the user (core/profile)."
    },
    "part": {
      "type": "string",
      "pattern": "^[0-9]+/[0-9]+$",
      "description": "This file's part, e.g. 2/3, when the description is split."
    },
    "partial": {
      "type": "boolean",
      "description": "true: describes only what is listed (e.g. one project, from inside it); nothing else is touched."
    },
    "instructions_version": {
      "type": [
        "string",
        "number"
      ],
      "description": "The version of the harness instructions the tool followed (the connector hands over newer ones)."
    }
  }
}
