{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chanaza/my-harness/schemas/claude-account.schema.json",
  "title": "claude-account/1",
  "description": "What the harness-account skill writes in describe mode: everything a Claude account has built, one list per kind of the harness.",
  "type": "object",
  "required": ["schema", "account", "captured_at", "surface"],
  "additionalProperties": false,
  "$defs": {
    "named": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}},
    "text": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string"}}}
  },
  "properties": {
    "schema": {"const": "claude-account/1"},
    "account": {"type": "string", "minLength": 3},
    "captured_at": {"type": ["string", "object"]},
    "surface": {"enum": ["cowork", "claude-ai", "desktop"]},
    "profile": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
    "instructions": {"type": ["array", "null"], "items": {"allOf": [{"$ref": "#/$defs/named"}, {"$ref": "#/$defs/text"}]}},
    "memory": {"type": ["array", "null"], "items": {"$ref": "#/$defs/text"}},
    "skills": {"type": ["array", "null"], "items": {"allOf": [{"$ref": "#/$defs/named"},
      {"properties": {"origin": {"enum": ["mine", "anthropic", "plugin"]}}}]}},
    "agents": {"type": ["array", "null"], "items": {"$ref": "#/$defs/named"}},
    "plugins": {"type": ["array", "null"], "items": {"allOf": [{"$ref": "#/$defs/named"},
      {"properties": {"origin": {"enum": ["mine", "marketplace"]}}}]}},
    "connections": {"type": ["array", "null"], "items": {"allOf": [{"$ref": "#/$defs/named"},
      {"properties": {"kind": {"enum": ["connector", "mcp"]}}}]}},
    "projects": {"type": ["array", "null"], "items": {"$ref": "#/$defs/named"}},
    "workflows": {"type": ["array", "null"], "items": {"$ref": "#/$defs/named"}},
    "apps": {"type": ["array", "null"], "items": {"$ref": "#/$defs/named"}},
    "native": {"type": ["array", "null"], "items": {"$ref": "#/$defs/named"}},
    "cannot_see": {"type": ["array", "null"], "items": {"type": "string"}}
  }
}
