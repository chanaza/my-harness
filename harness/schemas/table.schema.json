{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chanaza/my-harness/schemas/table.schema.json",
  "title": "Table schema (apps/<app>/schema/<table>.yaml)",
  "type": "object",
  "required": [
    "name",
    "fields",
    "provenance"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Type as the source tool names it (text, number, status, ...)."
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "references": {
            "type": "string",
            "description": "<table>.<field> this field points to."
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    }
  },
  "additionalProperties": false
}
