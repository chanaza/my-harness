{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chanaza/my-harness/schemas/provenance.schema.json",
  "title": "Provenance: where an item came from and every tool that changed it",
  "type": "object",
  "required": [
    "source"
  ],
  "properties": {
    "source": {
      "$ref": "#/$defs/event",
      "description": "The profile and session that first created this item."
    },
    "updates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "description": "Later changes, oldest first."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "profile",
        "at"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Profile id from core/profiles.yaml (a tool + account)."
        },
        "session": {
          "type": "string",
          "description": "Session id (sessions/<tool>/<session-id>/), when known."
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
