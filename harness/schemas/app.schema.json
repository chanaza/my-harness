{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chanaza/my-harness/schemas/app.schema.json",
  "title": "App spec (apps/<app>/app.yaml)",
  "type": "object",
  "required": [
    "name",
    "profile",
    "purpose",
    "provenance"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[^\\W_A-Z](?:[^\\W_A-Z]|-)*$"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Profile (tool + account) the app is built in."
    },
    "purpose": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "logic": {
      "type": "string",
      "description": "Business rules in plain words."
    },
    "requires": {
      "type": "object",
      "description": "What must exist in a tool for this to work. Names only, never secrets.",
      "properties": {
        "connections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\W_A-Z](?:[^\\W_A-Z]|-)*$"
          },
          "uniqueItems": true,
          "description": "Ids from core/connections.yaml."
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Built-in capabilities, e.g. web-search, code-execution."
        }
      },
      "additionalProperties": false
    },
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "description": "Language this file is written in."
    },
    "original": {
      "type": "string",
      "description": "Relative path to the original-language version, when this file is a translation."
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    },
    "version": {
      "type": "string",
      "description": "The tool's version of the app when it was saved (only changed versions are copied again)."
    }
  },
  "additionalProperties": false
}
