{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chanaza/my-harness/schemas/agent.schema.json",
  "title": "Agent definition (core/agents/<name>.yaml)",
  "type": "object",
  "required": [
    "name",
    "description",
    "instructions",
    "provenance"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[^\\W_A-Z](?:[^\\W_A-Z]|-)*$"
    },
    "description": {
      "type": "string"
    },
    "instructions": {
      "type": "string",
      "description": "Inline text or a relative path to a .md file."
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Skills the agent uses (harness skill names or the tool's catalog names)."
    },
    "requires": {
      "type": "object",
      "description": "What must exist in a tool for this to work. Names only, never secrets.",
      "properties": {
        "connections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\W_A-Z](?:[^\\W_A-Z]|-)*$"
          },
          "uniqueItems": true,
          "description": "Ids from core/connections.yaml."
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Built-in capabilities, e.g. web-search, code-execution."
        }
      },
      "additionalProperties": false
    },
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "description": "Language this file is written in."
    },
    "original": {
      "type": "string",
      "description": "Relative path to the original-language version, when this file is a translation."
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    },
    "native": {
      "type": "object",
      "description": "Tool-specific fields kept verbatim, keyed by tool id.",
      "additionalProperties": {
        "type": "object"
      }
    },
    "origin": {
      "type": "string",
      "description": "Where the item lived in the source tool."
    },
    "role": {
      "type": "string",
      "description": "The agent's role or job title."
    },
    "goal": {
      "type": "string",
      "description": "What the agent is for."
    },
    "identity": {
      "type": "string",
      "description": "Persona / how the agent presents itself."
    },
    "policies": {
      "type": "array",
      "description": "Rules the agent must follow.",
      "items": {}
    },
    "knowledge": {
      "type": "array",
      "description": "What the agent knows: references to boards, docs, files.",
      "items": {
        "type": "object"
      }
    },
    "model": {
      "type": "string",
      "description": "The model the agent is set to use, if any."
    }
  },
  "additionalProperties": false
}
